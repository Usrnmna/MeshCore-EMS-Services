# Normalize maintained text without converting file encodings.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.sql text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.cs text eol=lf
*.ui text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.iss text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf

# Preserve binary distributions and media byte-for-byte.
*.exe -text
*.dll -text
*.zip -text
*.gz -text
*.7z -text
*.bz2 -text
*.xz -text
*.zst -text
*.whl -text
*.pyd -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.pdf -text
*.sqlite3 -text
*.db binary
*.sqlite binary
*.parquet binary
*.kmz binary
*.dbf binary
*.gpkg binary
*.shp binary
*.shx binary
*.tif binary
*.tiff binary
*.xlsx binary

# Reference datasets and supplier receipts retain hashed bytes and source whitespace.
/data/** -text -whitespace
/meshcore_mqtt_service/data/landslide/** -text -whitespace
/meshcore_mqtt_service_windows/data/landslide/** -text -whitespace
/meshcore_mqtt_service/data/wildfire/** -text -whitespace
/meshcore_mqtt_service_windows/data/wildfire/** -text -whitespace
/data/**/*.py text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab
/data/**/README.md text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab
/data/**/FUNCTION_REFERENCE.md text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab
/data/**/DATA_DICTIONARY.md text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab

# Maintained collection guides and dependency lists are editable source text.
# Direct-child patterns exclude archived copies in generation subdirectories.
/data/basin_plans/*.md text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab
/data/flood_impacts/*.md text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab
/data/usgs_water/*.md text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab
/data/basin_plans/requirements.txt text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab
/data/flood_impacts/requirements.txt text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab
/data/usgs_water/requirements.txt text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab

# Immutable generation manifests hash code and documentation as well as data.
# These rules must follow text exceptions so every archived byte is preserved.
/data/basin_plans/snapshots/** -text -whitespace
/data/basin_plans/organized/** -text -whitespace
/data/flood_impacts/static/** -text -whitespace
/data/flood_impacts/observations/** -text -whitespace
/data/usgs_water/inventory/** -text -whitespace
/data/usgs_water/observations/** -text -whitespace
/data/usgs_water/network/** -text -whitespace
/data/usgs_water/routing/** -text -whitespace
/data/usgs_water/link_review/** -text -whitespace
/data/usgs_water/agency_review/** -text -whitespace
/data/usgs_water/local_review/** -text -whitespace

# Local managed generations are immutable even when they contain source copies.
# Ignore rules exclude these paths; attributes also protect explicitly added files.
**/.datasets/** -text -whitespace
