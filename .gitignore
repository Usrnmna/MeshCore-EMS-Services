# Repository source, command programs, tests, configuration templates, AGENTS.md,
# documentation, curated configuration and existing reference assets remain trackable.
# Retain COMMAND_REFERENCE.md, BOT_USER_GUIDE.md, and native GIS source archives.
# Water collection downloads are local-only; do not blanket-ignore scripts/ or data/.

# Installed dependencies and local service state
.venv/
.venv-*/
runtime/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Local documentation previews and optional JavaScript rendering dependencies
node_modules/
.cache/
playwright-report/
test-results/

# Local planning documents and disposable desktop authorization sessions.
/docs/superpowers/
/meshcore-desktop-*/
/meshcore-history-*/

# Generated dependency metadata and optional local pip caches
*.egg-info/
pip-wheel-metadata/
.pip-cache/

# Local test coverage reports; keep test source and fixtures trackable.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local environment files; retain the distributable example.
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Rebuilt distribution packages and local recovery snapshots
dist/
# dist/ covers every release version, including installers, bundles, and checksums.
# Already tracked distribution files remain tracked until explicitly removed.

# Conventional Python build output and interrupted archive publication
build/
*.zip.tmp
.build/
archive/*.zip

# Dataset GUI packaging and exported session logs outside the default build folders.
# Keep the editable .ui form, Python source, requirements and build scripts trackable.
MeshCore-EMS-Dataset-Manager.spec
MeshCore-EMS-Service-Setup.spec
dataset-manager.log
dataset-manager.log.*

# SQLite transient files (keep the supplied reference database)
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Local service credentials, including private channel keys
environment.json

# Installer-generated credentials, temporary settings, and recovery state
environment.json.tmp
config.json.tmp
config.before-install.json
config.rollback.json
satellite-settings.json.tmp
/backups/
/meshcore_mqtt_service/backups/
/meshcore_mqtt_service_windows/backups/

# Interrupted satellite export/cache writes; retain reference data and raw receipts.
/data/satellites/*.json.tmp
/data/satellites/*.csv.tmp
/data/satellites/raw/*.tmp

# Transient GIS maintenance state; retain snapshots, manifests, and originals/.
.refresh.lock

# Managed dataset generations, activation registry, and maintenance locks.
# Curated settings, source adapters, and bundled reference seeds remain trackable.
.datasets/
datasets.json
datasets.json.*.tmp
.datasets.lock
.gui-manager.lock
/.dataset-test-temp/

# Interrupted collection refreshes and GIS settings writes.
.refresh-*/
.test-refresh-*/
# Cover pending generations in current and future collection stages.
/data/basin_plans/**/.pending-*/
/data/flood_impacts/**/.pending-*/
/data/usgs_water/**/.pending-*/
/data/usgs_water/.dependencies/
/data/usgs_water/.dependency-temp/
gis_settings.json.tmp
/data/**/*.download
/data/**/*.geojson.tmp
# Water collection output exclusions are listed below; curated rules remain trackable.

# Local operating-system metadata and editor swap files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Machine-local IDE state; shared source and editor configuration remain trackable.
.vs/
*.suo
*.user

# Qt Creator machine-local settings, backups and generated build directories.
# Shared project definitions and Designer .ui forms remain trackable.
*.user.*
*.ui.autosave
.qtcreator/
.qtc_clangd/
/build-*/

