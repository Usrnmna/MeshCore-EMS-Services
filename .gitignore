# Installed dependencies and local service state
.venv/
.venv-linux/
runtime/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Local test coverage reports; keep test source and fixtures trackable.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local environment files; retain the distributable example.
.env
.env.*
!.env.example

# Rebuilt distribution packages and local recovery snapshots
dist/
.build/
archive/*.zip

# SQLite transient files (keep the supplied reference database)
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Local service credentials, including private channel keys
environment.json

# Installer-generated credentials, temporary settings, and recovery state
environment.json.tmp
config.json.tmp
config.before-install.json
config.rollback.json
satellite-settings.json.tmp
/backups/
/meshcore_mqtt_service/backups/
/meshcore_mqtt_service_windows/backups/

# Interrupted satellite export/cache writes; retain reference data and raw receipts.
/data/satellites/*.json.tmp
/data/satellites/*.csv.tmp
/data/satellites/raw/*.tmp
