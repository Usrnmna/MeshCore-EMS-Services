<script>
    window.addEventListener('load', function () {
      setTimeout(function () {
        // Load the gtag.js script
        var gaScript = document.createElement('script');
        gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-WFK3K5ECCC';
        gaScript.async = true;
        document.head.appendChild(gaScript);
  
        // Once loaded, initialize gtag
        gaScript.onload = function () {
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', 'G-WFK3K5ECCC');
        };
      }, 3000); // Delay GA4 load by 3 seconds
    });

    function loadScriptWithFadeIn(src, timeout) {
    var script = document.createElement('script');
    script.src = src;
    script.async = true;
  
    var timeoutId = setTimeout(function() {
      console.log('Script load timed out: ' + src);
    }, timeout);
  
    script.onload = function() {
      clearTimeout(timeoutId);
  
      // Fade in the button (if it exists)
      var button = document.getElementById('fba-button');
      if (button) {
        button.style.display = 'inline-block';
        setTimeout(function() {
          button.classList.add('show');
        }, 50);
      }
  
      // Update aria-label on skip nav (if element exists)
      const skipNavLink = document.querySelector('.usa-skipnav.touchpoints-skipnav');
      if (skipNavLink) {
        skipNavLink.setAttribute('aria-label', 'Skip to feedback');
      }
    };
  
    document.body.appendChild(script);
  }
  
  
  // Usage: Load the scripts and fade in the button
  loadScriptWithFadeIn('https://touchpoints.app.cloud.gov/touchpoints/df7e5897.js', 5000);  // 5 seconds timeout
  loadScriptWithFadeIn('https://siteimproveanalytics.com/js/siteanalyze_6294131.js', 5000);  // 5 seconds timeout

  </script>
  
