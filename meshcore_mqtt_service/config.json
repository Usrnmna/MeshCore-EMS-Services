{
  "mqtt": {
    "host": "127.0.0.1",
    "port": 1883,
    "prefix": "meshcore/usb",
    "client_id": "meshcore-usb-bridge",
    "username_env": "MESHCORE_MQTT_USERNAME",
    "password_env": "MESHCORE_MQTT_PASSWORD",
    "tls": false,
    "ca_file": null
  },
  "local_broker": true,
  "baudrate": 115200,
  "command_timeout": 45,
  "command_interval": 15,
  "responder": {
    "enabled": true,
    "script_timeout": 20,
    "max_output_bytes": 65536,
    "max_reply_parts": 4,
    "max_message_age": 300,
    "sender_cooldown": 30,
    "max_pending": 50,
    "commands": {
      "!status": {
        "script": "scripts/status.py",
        "args": [],
        "channels": [
          "default"
        ]
      },
      "!time": {
        "script": "scripts/time_now.py",
        "args": [],
        "channels": [
          "default"
        ]
      },
      "!aqi": {
        "script": "scripts/airnow_aqi.py",
        "args": [],
        "input": "coordinates",
        "timeout": 60,
        "error_reply": "AirNow lookup unavailable. Check the service AIRNOW_API_KEY setting or try again later.",
        "channels": [
          "default"
        ]
      },
      "!traffic": {
        "script": "scripts/highway_info.py",
        "args": [],
        "input": "route_number",
        "timeout": 30,
        "error_reply": "Caltrans traffic lookup unavailable. Please try again later.",
        "channels": [
          "default"
        ]
      },
      "!rivers": {
        "script": "scripts/nearby_river_stations.py",
        "args": [
          "--mesh-text",
          "--timeout",
          "15"
        ],
        "input": "coordinates",
        "coordinate_style": "options",
        "timeout": 40,
        "error_reply": "River station lookup unavailable. Please try again later.",
        "channels": [
          "default"
        ]
      },
      "!uv": {
        "script": "scripts/uv_index.py",
        "args": [],
        "input": "location",
        "timeout": 35,
        "error_reply": "UV lookup unavailable. Please try again later.",
        "channels": [
          "default"
        ]
      },
      "!heatadv": {
        "script": "scripts/heat_adv.py",
        "args": [],
        "input": "location",
        "timeout": 45,
        "max_reply_parts": 12,
        "error_reply": "Heat alert lookup unavailable. Please try again later.",
        "channels": [
          "default"
        ]
      },
      "!floodwarn": {
        "script": "scripts/flood_warn.py",
        "args": [],
        "input": "location",
        "timeout": 45,
        "max_reply_parts": 12,
        "error_reply": "Flood alert lookup unavailable. Please try again later.",
        "channels": [
          "default"
        ]
      },
      "!snowpack": {
        "script": "scripts/snowpack.py",
        "args": [],
        "input": "location",
        "timeout": 65,
        "error_reply": "Snowpack lookup unavailable. Please try again later.",
        "channels": [
          "default"
        ]
      },
      "!floodalarm": {
        "script": "scripts/flood_warn.py",
        "args": [],
        "input": "location",
        "max_reply_parts": 12,
        "channels": [
          "default"
        ]
      }
    },
    "channels": {
      "default": {
        "name": "#autatestbot",
        "type": "hashtag",
        "mqtt_export": true
      }
    },
    "max_pending_per_channel": 20
  },
  "serial_port": "auto",
  "connection": {
    "type": "serial",
    "timeout": 30
  }
}
