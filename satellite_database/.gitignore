# Retain catalog programs, tests, settings.json, operator_overrides.json, schema,
# documentation, reference databases, exports, and original source receipts.
# Retain Markdown guides and source archives; no blanket document/archive exclusion.
# Temporary output rules below must not exclude the corresponding final files.

# Installed dependencies, bytecode, and temporary test workspaces
.venv/
.venv-*/
__pycache__/
*.py[cod]
test-work-*/

# Generated dependency metadata, caches, and local test reports
*.egg-info/
pip-wheel-metadata/
.pip-cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.build/
dist/
# dist/ covers every release version, including installers, bundles, and checksums.
# Already tracked distribution files remain tracked until explicitly removed.

# Conventional Python build output and interrupted archive publication
build/
*.zip.tmp

# Local environment settings; retain the distributable example.
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Managed dataset state in standalone copies; retain reference databases and exports.
.datasets/
datasets.json
datasets.json.*.tmp
.datasets.lock

# Interrupted exports and SQLite sidecars; retain reference databases and receipts.
*.json.tmp
*.csv.tmp
raw/*.tmp
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Local operating-system metadata and editor swap files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Local verification caches and reports
.hypothesis/
.benchmarks/
junit-results.xml
node_modules/
.cache/
playwright-report/
test-results/

# SQLite sidecars from optional operator database filenames
*.db-wal
*.db-shm
*.db-journal
.vs/
*.suo
*.user

# Local service credentials in standalone catalog checkouts.
environment.json

# Local credential copies; distributable templates remain trackable.
environment.json.*
!environment.json.example
!environment.json.template

# Logs created in this checkout's root or its local log directory.
# Reference receipts and test fixtures in other directories remain trackable.
/logs/
/*.log
/*.log.*
